# ============================================================================
# NSCET AI COLLEGE ASSISTANT - BACKEND ENVIRONMENT CONFIGURATION SAMPLE
# Copy this file to .env and replace placeholder values before running.
# NEVER commit .env or expose secrets in frontend code.
# ============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Authentication & Security
# Generate a strong 64-char random secret in production (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-strong-64-character-random-secret-key
JWT_EXPIRES_IN=24h

# Database Configuration
# Option 1 (Production): PostgreSQL with pgvector extension
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nscet_chatbot
# DB_SSL=false
# Option 2 (Zero-config Local Development): Leave DATABASE_URL empty to use
# built-in Node SQLite persistence at ./data/nscet_chatbot.db
DATABASE_URL=
SQLITE_DB_PATH=./data/nscet_chatbot.db

# OpenAI API Configuration (Required for live LLM & OpenAI embeddings)
# Leave blank only for offline/demo RAG fallback testing
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG Pipeline Settings
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=180
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.18
MAX_UPLOAD_SIZE_MB=15

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
CHAT_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_MAX=15
